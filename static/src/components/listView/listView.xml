<templates xml:space="preserve">
    <t t-name="app_one.ListView">
    <div class="app_one_list_view">

        <h1>Hello world</h1>

        <button class="btn btn-primary m-1 p-1"
                t-on-click="createRecord">
            Create Record
        </button>

        <table>
            <thead>
                <tr>
                    <th>Postcode</th>
                    <th>Name</th>
                    <th>Date Availability</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <t t-foreach="state.records" t-as="record" t-key="record.id">
                    <tr>
                        <td><t t-esc="record.postcode"/></td>
                        <td><t t-esc="record.name"/></td>
                        <td><t t-esc="record.date_availability"/></td>

                        <td>
                            <button class="btn btn-danger" t-on-click="() => this.deleteRecord(record.id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

    </div>
</t>

