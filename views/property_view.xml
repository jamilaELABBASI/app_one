    <!-- Action -->
    <record id="property_action" model="ir.actions.act_window">
        <field name="name">property</field>
        <field name="res_model">property</field>
        <field name="view_mode">list,form</field>
    </record>
        <!--   -->
<!--    # ajouter server action avec code on a vu aussi via interface video 44-->
<!--    # ajouter une action aux actions dinterface-->
    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">Closed</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
            action=records.action_closed()
        </field>
    </record>

    <!-- Scheduled Actions) dans linterface : technical -> Scheduled Actions -->
    <record id="check_selling_date_cron" model="ir.cron">
            <field name="name">Property: Check selling date</field>
            <field name="model_id" ref="model_property"/>
            <field name="state">code</field>  <!-- Indique le type d’action code = exécuter du code Python -->
            <field name="code">model.check_expected_selling_date()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <!--<field name="repeat_type">number</field>
            <field name="repeat_number">1</field>
            # ilimited (unfonctionnel)if i want number exact of day i do make 3 etc
            #Active ou désactive le cron
            -->
            <field name="active">True</field>
    </record>

    <record id="property_change_state_wizard_server_action" model="ir.actions.server">
        <field name="name">Change State</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">
           action=records.action_open_change_state_wizard() <!-- methode definit ddans le model property -->
        </field>
    </record>

             <!-- Menu -->
    <menuitem
        id="property_menu_item"
        name="Properties"
        parent="properties_menu"
        action="property_action"
    />

    <record id="list_view_owl_action" model="ir.actions.client">
        <field name="name">Properties List View</field>
        <field name="tag">app_one.action_list_view</field>
    </record>

    <menuitem
        id="property_list_view_menu_item"
        name="Properties OWL"
        parent="properties_menu"
        action="list_view_owl_action"
    />
</odoo>
