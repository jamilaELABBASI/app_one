<odoo>
        <!-- Vue liste -->
    <record id="property_view_list" model="ir.ui.view">
        <field name="name">property list</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <!-- afficher en rouge lenregistrement qui sa date dexperation est passe-->
            <list class="header_custom" decoration-danger="is_late" multi_edit="1" create="1" edit="1" delete="0" >
                <header>
                    <button name="property_xlsx_report" type="object" string="Print Excel File" class="btn-primary"/>
                </header>
                <!-- multi_edit="1"
                design quand je click sur un seule element jaccede au formulaire de modification
                et si je selectionne deux ou plus je peux modifie les elements sur la liste directement

                read nous pouvons pas la controler a partir dici
                -->
                <field name="name"/>
                <field name="is_late" invisible="True"/>
                <field name="owner_id"/>
                <field name="postcode"/>
                <field name="date_availability"/>
                <field name="description"/>
                <field name="selling_price"/>
                <field name="garden"/>
                <field name="facades"/>
                <field name="state"/>
                <field name="garden_area"/>
                <field name="bedrooms" optional="1"/>
                <field name="garage" optional="1"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!--
            🔍 Explication ligne par ligne
            🔹 <record id="property_view_tree" model="ir.ui.view">
            Ce bloc crée un enregistrement dans la base Odoo pour définir une vue.
            id="property_view_tree" → identifiant interne pour appeler cette vue
            model="ir.ui.view" → on dit à Odoo qu’on crée une vue

            🔹 <field name="name">property.list</field>
            C’est le nom de la vue, utilisé juste pour la reconnaître.
            Tu peux mettre ce que tu veux.

            🔹 <field name="model">property</field>
            Ça indique que cette vue appartient au modèle Python

            🔹 <field name="arch" type="xml"> ... </field>
            arch = architecture de la vue = contenu XML détaillant la vue.
    -->

        <!-- Vue formulaire -->
    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form  create="1" edit="1" delete="0"> <!-- masquer le button delete-->
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_related_owner" type="object" icon="fa-user" string="Owner" invisible="not owner_id"/>
                    </div>
                    <!-- afficher une bonde -->
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="state!='sold'"/>
                    <header>
                        <button name="action" type="object" string="Action" class="btn-primary"/>
                        <button name="get_properties" type="object" string="Test Get Properties" class="btn-primary"/>

                        <!-- invisible="state in ['draft','closed']  invisible="state!='pending'" -->
                       <!--
                        <button name="action" type="object" string="Action" class="btn-primary"/>
                        <button name="action_state" type="object" string="Change State" class="btn-success"/>
                        <button name="action_draft" type="object" string="Set To Draft" class="btn-primary" invisible="state=='draft'"/>
                        <button name="action_pending" type="object" string="Set To Pending" class="btn-danger" invisible="state=='pending'"/>
                        <button name="action_sold" type="object" string="Set To Sold" class="btn-warning" invisible="state=='sold'"/>
                        <button name="action_closed" type="object" string="Set to closed" class="btn-success" invisible="state=='closed'"/>-->
                        <field name="state" widget="statusbar"/>
                        <!-- si je veux affiher 2 status statusbar_visible="draft,sold"
                        pour le rendre state clickable options="{'clickable': 1}"
                        # si je veux aussi changer le status de property et history quand je click surr statusbar je dois ajouter option clickable
                        sur field state et creer une method @api.onchange('state') qui va changer le status du property et appeler la methode create history
      -->
                    </header>
                    <div class="oe_title">
                        <label for="ref"/>
                            <h2> <field name="ref"/> </h2>
                        <label for="name"/>
                            <h3> <field name="name"/> </h3>
                    </div>
                   <group>
                        <group string="General Infos">
                            <field name="create_time" readonly="1"/>
                            <field name="next_time" readonly="1"/>
                            <field name="owner_id"/>
                            <field name="date_availability" readonly="state=='closed'"/>
                            <field name="expected_selling_date" readonly="state in ['sold','closed']"/>
                            <field name="postcode"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="diff"/>
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="facades"/>
                        </group>
                        <group string="Additional Infos">
                            <field name="owner_phone"/>
                            <field name="owner_adresse"/>
                            <field name="garden"/>
                            <field name="garden_area"/>
                            <field name="garage"/>
                            <field name="garden_orientation"/>
                            <field name="active"/>
                            <field name="is_late"/>
                            <field name="description"/>
                        </group>
                   </group>
                    <group>
                        <field name="description"   groups="app_one.property_manager_group"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <sheet>
                    <!-- ajouter logs -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
                </sheet>
                <notebook>
                    <page string="Bedrooms">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <!-- editable="bottom" ne pas afficher pop up pour ajouter un nouveau record et mettre le champs clickable et on peut le modifier directement -->
                                    <field name="area"/>
                                    <field name="description"/>
                                </list>
                            </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

          <!--  Vu de recherche
                la bare de recherche chercher par nom par defaut
                si vous voulez chercher par plus de champs vous devez crerr une vu de recherche
                les champs de filter seront afficher avec le meme classement que ici
          -->

