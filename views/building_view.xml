<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="building_view_list" model="ir.ui.view">
        <field name="name">building list</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
             <list class="header_custom" >
                 <field name="no"/>
                <field name="code"/>
                 <field name="active"/>
                <field name="description"/>
             </list>
        </field>
    </record>

     <record id="building_view_form" model="ir.ui.view">
         <field name="name">building.form</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                     <group string="Necessary Infos">
                         <field name="name"/>
                         <field name="no"/>
                     </group>
                     <group string="Additional Infos">
                         <field name="code"/>
                         <field name="active"/>
                     </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
        </form>
        </field>
     </record>
    <record id="buildinng_action" model="ir.actions.act_window">
        <field name="name">building</field>
        <field name="res_model">building</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
    id="building_menu_item"
    name="Building"
    parent="building_menu"
    action="buildinng_action"
    />
</odoo>

